{
  "name": "independent-pos-telegram",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@pos/api & npm run dev --workspace=@pos/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=@pos/api",
    "test:e2e": "playwright test",
    "db:migrate": "npm run migrate --workspace=@pos/database",
    "admin:create": "npm run admin:create --workspace=@pos/database",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  }
}
